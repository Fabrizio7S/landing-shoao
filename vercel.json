{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "landing-shoao.vercel.app"
        }
      ],
      "destination": "https://www.shoaomaple.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "landing-shoao-dtkc.vercel.app"
        }
      ],
      "destination": "https://www.shoaomaple.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "landing-shoao-9kye.vercel.app"
        }
      ],
      "destination": "https://www.shoaomaple.com/$1",
      "permanent": true
    },
    {
      "source": "/guias/maerin/",
      "destination": "/guias/mayrin/",
      "permanent": true
    },
    {
      "source": "/guias/maerin/:path*",
      "destination": "/guias/mayrin/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|guias/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
