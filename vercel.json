{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "landing-shoao.vercel.app" }],
      "destination": "https://www.shoaomaple.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "landing-shoao-dtkc.vercel.app" }],
      "destination": "https://www.shoaomaple.com/:path*",
      "permanent": true
    },
    {
      "source": "/guias/maerin/",
      "destination": "/guias/mayrin/",
      "permanent": true
    },
    {
      "source": "/guias/maerin/:path*",
      "destination": "/guias/mayrin/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|guias/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
